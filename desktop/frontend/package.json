{
  "name": "ds-code-desktop-frontend",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
