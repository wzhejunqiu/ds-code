    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.5",
    "vitest": "^3.2.4"
  }
